{
  "schema_version": 1,
  "family_id": "pilot_cloud_generation",
  "category": "cloud object generation",
  "title": "Object metadata check followed by delete",
  "description": "A workflow checks cloud object metadata, then deletes by object name after the generation may change.",
  "resource": "object_name",
  "variants": [
    {
      "kind": "vulnerable",
      "check_contract": "cloud_generation.get_object_metadata",
      "effect_contract": "cloud_generation.delete_without_generation",
      "expected_result": "candidate_risk",
      "mutation": "replace object generation before delete",
      "repair_obligation": "send the checked generation as an enforced delete precondition",
      "representations": ["langgraph_source", "mcp_trace"]
    },
    {
      "kind": "repaired",
      "check_contract": "cloud_generation.get_object_metadata",
      "effect_contract": "cloud_generation.delete_with_generation",
      "expected_result": "protected",
      "mutation": "replace object generation before delete",
      "repair_obligation": "version binding is authority-enforced",
      "representations": ["langgraph_source", "mcp_trace"]
    },
    {
      "kind": "safe_near_miss",
      "check_contract": "cloud_generation.get_object_metadata",
      "effect_contract": "cloud_generation.delete_with_generation",
      "expected_result": "safe_near_miss",
      "mutation": "replace a different object",
      "repair_obligation": "no repair required because object identity differs",
      "representations": ["mcp_trace"]
    }
  ]
}
