      "mutation": "close order row before update",
      "repair_obligation": "pass the checked row version as an enforced update precondition",
      "representations": ["langgraph_source", "mcp_trace"]
    },
    {
      "kind": "repaired",
      "check_contract": "db_row_version.read_order",
      "effect_contract": "db_row_version.update_with_version",
      "expected_result": "protected",
      "mutation": "close order row before update",
      "repair_obligation": "version binding is authority-enforced",
      "representations": ["langgraph_source", "mcp_trace"]
    },
    {
      "kind": "safe_near_miss",
      "check_contract": "db_row_version.read_order",
      "effect_contract": "db_row_version.update_with_version",
      "expected_result": "safe_near_miss",
      "mutation": "close a different order row",
      "repair_obligation": "no repair required because row identity differs",
      "representations": ["langgraph_source"]
