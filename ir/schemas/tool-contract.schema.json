{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlint.local/schemas/tool-contract.schema.json",
  "title": "AgentLint Tool Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "operation",
    "resource_argument",
    "binding_mechanisms",
    "authority_behavior"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "contract_id": { "type": "string", "minLength": 1 },
    "operation": { "enum": ["read", "check", "effect", "write"] },
    "resource_argument": { "type": "string", "minLength": 1 },
    "predicate": { "type": ["string", "null"], "minLength": 1 },
    "binding_mechanisms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "none",
          "atomic",
          "version",
          "stable_identity",
          "revalidation",
          "synchronization"
        ]
      }
    },
    "authority_behavior": { "enum": ["enforced", "advisory", "unknown"] },
    "version_argument": { "type": ["string", "null"], "minLength": 1 },
    "effect_category": { "type": ["string", "null"], "minLength": 1 },
    "safety_oracle": { "type": ["string", "null"], "minLength": 1 }
  }
}
